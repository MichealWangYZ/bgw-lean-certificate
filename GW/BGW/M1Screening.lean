/-! ### The concrete certificate

Both products are checked by kernel arithmetic on the encoded data. These are
the only numerically data-dependent proofs in the module. -/

set_option maxRecDepth 40000
set_option maxHeartbeats 4000000

theorem Rref_mul_E : Rref * E = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [Matrix.mul_apply, Fin.sum_univ_succ, E, Rref, Matrix.one_apply,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

theorem E_mul_Rref : E * Rref = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [Matrix.mul_apply, Fin.sum_univ_succ, E, Rref, Matrix.one_apply,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

/-! ### Conclusions for this input -/

/-- `Rref` is THE inverse of the represented `E`: any `Y` with `E * Y = 1`
equals it. -/
theorem Rref_unique {Y : Matrix (Fin 8) (Fin 8) ℚ} (hY : E * Y = 1) : Y = Rref :=
  unique_solution Rref_mul_E E_mul_Rref hY

/-- The screened interaction for the represented input. -/
def Wref : Matrix (Fin 8) (Fin 8) ℚ := Rref * V

/-- **The screening equation holds**: `E * Wref = V`. Derived from the
certificate, so no second large product is checked. -/
theorem E_mul_Wref : E * Wref = V := by
  rw [Wref, ← Matrix.mul_assoc, E_mul_Rref, Matrix.one_mul]

/-- ... and `Wref` is its unique solution. -/
theorem Wref_unique {W : Matrix (Fin 8) (Fin 8) ℚ} (hW : E * W = V) : W = Wref :=
  unique_solution Rref_mul_E E_mul_Wref hW

