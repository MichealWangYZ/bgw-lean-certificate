/-- The literal above IS the exact formation from the exported operands. -/
theorem Estar_eq : Estar = 1 - V * chi := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num (config := { decide := true }) [Estar, V, chi, vc, Matrix.mul_apply, Fin.sum_univ_succ,
      Matrix.diagonal_apply, Matrix.one_apply, Matrix.sub_apply,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

/-- The formation difference. Nonzero in every entry. -/
def Delta : Matrix (Fin 8) (Fin 8) ℚ := Ehat - Estar

/-- `gamma_2 = 2u/(1-2u)` with `u = 2^-53`, exactly `1/(2^52 - 1)`. -/
def gamma2 : ℚ := 1 / (2 ^ 52 - 1)

/-- The frozen per-entry formation budget
`B i j = gamma2 * (|delta_ij| + |V_ii * chi_ij|)`. Conservative for both the
traced two-rounding path and a fused one. -/
def B (i j : Fin 8) : ℚ :=
  gamma2 * (absQ ((1 : Matrix (Fin 8) (Fin 8) ℚ) i j) + absQ (vc i * chi i j))

/-- **Formation certificate.** The observed discrepancy between the stored
matrix and the exact formation is within the budget, entry by entry. -/
theorem formation_bound : ∀ i j, |Delta i j| ≤ B i j := by
  intro i j
  rw [abs_le]
