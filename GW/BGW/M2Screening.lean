/-! ### Absolute value in a form the arithmetic normalizer evaluates

`|q|` on rational literals is not reduced by `norm_num` here, but `max q (-q)`
is. `absQ` is that form and `absQ_eq` proves it is the same function, so the
statements below are about ordinary absolute values. -/

/-- `|x|`, written so literal arithmetic reduces. -/
def absQ (x : ℚ) : ℚ := max x (-x)

theorem absQ_eq (x : ℚ) : absQ x = |x| := abs_eq_max_neg.symm

/-! ### The general algebraic step

The only new mathematics: how a difference in the matrix being inverted
propagates to a difference in the inverse. Stated for an arbitrary ring and
index type, then instantiated on the production data. -/

/-- **Inverse shift.** If `Rhat` is a left inverse of `Ehat` and `Rstar` a right
inverse of `Estar`, their difference is governed exactly by `Ehat - Estar`.
Multiplication order is preserved throughout. -/
theorem inverse_shift {R : Type*} [Ring R] {m : Type*} [Fintype m] [DecidableEq m]
    {Ehat Estar Rhat Rstar : Matrix m m R}
    (hL : Rhat * Ehat = 1) (hR : Estar * Rstar = 1) :
    Rhat - Rstar = -(Rhat * (Ehat - Estar) * Rstar) := by
  have h1 : Rhat * Ehat * Rstar = Rstar := by rw [hL, Matrix.one_mul]
  have h2 : Rhat * Estar * Rstar = Rhat := by
    rw [Matrix.mul_assoc, hR, Matrix.mul_one]
  rw [Matrix.mul_sub, Matrix.sub_mul, h1, h2, neg_sub]

/-- The screened form of the same step, with `W = R * V`. -/
theorem screened_shift {R : Type*} [Ring R] {m : Type*} [Fintype m] [DecidableEq m]
    {Ehat Estar Rhat Rstar V : Matrix m m R}
    (hL : Rhat * Ehat = 1) (hR : Estar * Rstar = 1) :
    Rhat * V - Rstar * V = -(Rhat * (Ehat - Estar) * Rstar * V) := by
  rw [← Matrix.sub_mul, inverse_shift hL hR, Matrix.neg_mul]

