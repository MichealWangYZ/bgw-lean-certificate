def nrmRstar : ℚ := (75328132496542801109292122894755942884571720023999826199276233491933770660501753020768780542683077085256067479959612118224512241031881168117181581704809465743511497295955972176679320855351085795391226326963004850380944776044024803251773910059525531947925241856 / 100049803524304312925504401844570549244689165063586393188611931365443399432762148099695307216368133843801324654079868293155362582452221190537770925869937214923304149316488695534624306888184848284354809988943177021830168108010198586479401791799654151839767610259 : ℚ)
def bForm : ℚ := (863422529232769485950040236973 / 761198769443178434211005819942477206510370816 : ℚ)

theorem nrmEhat_bounds : ∀ i, rowAbsSum Ehat i ≤ nrmEhat := by
  intro i
  fin_cases i <;>
    norm_num [rowAbsSum, absQ, Ehat, GW.BGW.E, nrmEhat, Fin.sum_univ_succ,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

theorem nrmRhat_bounds : ∀ i, rowAbsSum Rhat i ≤ nrmRhat := by
  intro i
  fin_cases i <;>
    norm_num [rowAbsSum, absQ, Rhat, GW.BGW.Rref, nrmRhat, Fin.sum_univ_succ,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

theorem nrmRstar_bounds : ∀ i, rowAbsSum Rstar i ≤ nrmRstar := by
  intro i
  fin_cases i <;>
    norm_num [rowAbsSum, absQ, Rstar, nrmRstar, Fin.sum_univ_succ,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

theorem bForm_bounds : ∀ i, (∑ j, B i j) ≤ bForm := by
  intro i
  fin_cases i <;>
    norm_num (config := { decide := true }) [B, absQ, gamma2, vc, chi, bForm, Fin.sum_univ_succ, Matrix.one_apply,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

/-- Inversion budget for the stored problem. The constant 100 is an engineering
choice fixed before measurement, not a proved LAPACK constant. -/
def bInv : ℚ := 100 * 8 * (1 / 2 ^ 53) * nrmEhat * nrmRhat ^ 2

/-- The propagated formation difference, the norm form of `inverse_shift`. -/
def bShift : ℚ := nrmRhat * bForm * nrmRstar

def bTotal : ℚ := bInv + bShift

/-! The task asks for the COMPONENT inequalities as well as the total. Added in
BGW-M2-R1: the acceptance review showed that a candidate can satisfy the total
budget while violating the separately advertised inversion budget, so proving
only the total does not enforce the stated contract. -/

/-- Inversion error for the STORED problem, against its own budget. -/
theorem inv_error_bound : ∀ i, rowAbsSum (Xhat - Rhat) i ≤ bInv := by
  intro i
  fin_cases i <;>
    norm_num [rowAbsSum, absQ, Xhat, Rhat, GW.BGW.Rref, bInv, nrmEhat, nrmRhat,
      Matrix.sub_apply, Fin.sum_univ_succ,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

/-- The propagated formation shift, against its own budget. This is the
numeric counterpart of `inverse_shift_instance`. -/
theorem shift_error_bound : ∀ i, rowAbsSum (Rhat - Rstar) i ≤ bShift := by
  intro i
  fin_cases i <;>
    norm_num [rowAbsSum, absQ, Rhat, GW.BGW.Rref, Rstar, bShift, nrmRhat,
      nrmRstar, bForm, Matrix.sub_apply, Fin.sum_univ_succ,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

/-- **The finite endpoint.** The actual encoded production inverse is within
the frozen total budget of the certified reference built from the
independently exported operands. Retained alongside the component bounds
above as a direct finite endpoint.

Corrected in BGW-M2-R2: an earlier version of this comment said the total is
not implied by the components. That is backwards for these definitions. Since
`bTotal = bInv + bShift`, the triangle inequality gives
`‖Xhat - Rstar‖ ≤ ‖Xhat - Rhat‖ + ‖Rhat - Rstar‖ ≤ bInv + bShift`, so the
components DO imply the total. What fails is the converse: the total bound
alone establishes neither component, which is why `inv_error_bound` and
`shift_error_bound` are proved separately rather than read off from here. -/
theorem total_error_bound : ∀ i, rowAbsSum (Xhat - Rstar) i ≤ bTotal := by
  intro i
  fin_cases i <;>
    norm_num [rowAbsSum, absQ, Xhat, Rstar, bTotal, bInv, bShift, nrmEhat, nrmRhat,
      nrmRstar, bForm, Matrix.sub_apply, Fin.sum_univ_succ,
      Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons]

end GW.BGW.M2
