import GW.BGW.M2Screening
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Mathlib.Algebra.Order.Field.Basic

namespace GW.BGW.M4

open GW.BGW

/-! ### Generic pieces -/

/-- Perturbation of a quotient. With `|Ih - Is| ≤ b ≤ |Is|/2` the production
divisor stays at least `|Is| - b` away from zero. -/
theorem quotient_transfer {Oh Os Ih Is Ph a b c : ℚ}
    (hO : |Oh - Os| ≤ a) (hI : |Ih - Is| ≤ b) (hP : |Ph - Oh / Ih| ≤ c)
    (hb : b ≤ |Is| / 2) (hIs : Is ≠ 0) :
    |Ph - Os / Is| ≤ c + a / (|Is| - b) + |Os| * b / (|Is| * (|Is| - b)) := by
  have hIs' : 0 < |Is| := abs_pos.mpr hIs
  have hb0 : 0 ≤ b := le_trans (abs_nonneg _) hI
  have hd : 0 < |Is| - b := by linarith
  have hIh : |Is| - b ≤ |Ih| := by
    have h1 := abs_sub_abs_le_abs_sub Is Ih
    rw [abs_sub_comm Is Ih] at h1
    linarith
  have hIh' : 0 < |Ih| := lt_of_lt_of_le hd hIh
  have hIh0 : Ih ≠ 0 := abs_pos.mp hIh'
  have key : Ph - Os / Is
      = (Ph - Oh / Ih) + (Oh - Os) / Ih + Os * (Is - Ih) / (Ih * Is) := by
    field_simp
    ring
  have t2 : |(Oh - Os) / Ih| ≤ a / (|Is| - b) := by
    rw [abs_div]
    have ha : 0 ≤ a := le_trans (abs_nonneg _) hO
    calc |Oh - Os| / |Ih| ≤ a / |Ih| := div_le_div_of_nonneg_right hO hIh'.le
      _ ≤ a / (|Is| - b) := div_le_div_of_nonneg_left ha hd hIh
  have t3 : |Os * (Is - Ih) / (Ih * Is)| ≤ |Os| * b / (|Is| * (|Is| - b)) := by
    rw [abs_div, abs_mul, abs_mul, abs_sub_comm Is Ih]
    have hn : 0 ≤ |Os| * b := mul_nonneg (abs_nonneg _) hb0
    calc |Os| * |Ih - Is| / (|Ih| * |Is|) ≤ |Os| * b / (|Ih| * |Is|) :=
          div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hI (abs_nonneg _))
            (mul_pos hIh' hIs').le
      _ ≤ |Os| * b / ((|Is| - b) * |Is|) :=
          div_le_div_of_nonneg_left hn (mul_pos hd hIs')
            (mul_le_mul_of_nonneg_right hIh hIs'.le)
      _ = |Os| * b / (|Is| * (|Is| - b)) := by rw [mul_comm (|Is| - b)]
  rw [key]
  calc |(Ph - Oh / Ih) + (Oh - Os) / Ih + Os * (Is - Ih) / (Ih * Is)|
      ≤ |(Ph - Oh / Ih) + (Oh - Os) / Ih| + |Os * (Is - Ih) / (Ih * Is)| := abs_add _ _
    _ ≤ |Ph - Oh / Ih| + |(Oh - Os) / Ih| + |Os * (Is - Ih) / (Ih * Is)| := by
        gcongr; exact abs_add _ _
    _ ≤ c + a / (|Is| - b) + |Os| * b / (|Is| * (|Is| - b)) := by
        linarith

/-- M2's certified row bound, read entrywise. -/
theorem m2_entry_bound (r s : Fin 8) : |M2.Xhat r s - M2.Rstar r s| ≤ M2.bTotal := by
  have h := M2.total_error_bound r
  rw [M2.rowAbsSum_eq] at h
  have hs : |(M2.Xhat - M2.Rstar) r s| ≤ ∑ k, |(M2.Xhat - M2.Rstar) r k| :=
    Finset.single_le_sum (f := fun k => |(M2.Xhat - M2.Rstar) r k|)
      (fun k _ => abs_nonneg _) (Finset.mem_univ s)
  simpa [Matrix.sub_apply] using hs.trans h

/-! ### The frozen target: source pair (1,2) of M2's basis -/

def srcRow : Fin 8 := 0
def srcCol : Fin 8 := 1

/-- `gmap` phases of the consumer rows G and G' (exactly ±1 in binary64). -/
def phA : ℚ := (1 / 1 : ℚ)
def phB : ℚ := (1 / 1 : ℚ)

/-- Operands of the wing normalization, as `sigma_main` passed them. -/
def wFact : ℚ := (8536803193978861 / 18446744073709551616 : ℚ)
def wOneOverQ : ℚ := (1662764007781095 / 35184372088832 : ℚ)
def wVcoul1 : ℚ := (3167053035019431 / 72057594037927936 : ℚ)
def wQlen : ℚ := (2388207853142927 / 4503599627370496 : ℚ)
def kappa : ℚ := wFact * wOneOverQ / (wVcoul1 * wQlen)

/-- M2's exported inverse entry, restated; `xhat_entry` ties it to `M2.Xhat`. -/
def xhatLit : ℚ := (2721441598579115 / 36028797018963968 : ℚ)
/-- The operand Sigma actually consumed, `epstemp(ind(ig))`, decoded. -/
def epsHat : ℚ := (1276842865003715 / 18014398509481984 : ℚ)

/-- Production `I_epsggp`, `Omega2 = wpmtx(ig)`, `wtilde2`, decoded. -/
def Ihat : ℚ := (-1276842865003715 / 18014398509481984 : ℚ)
def Ohat : ℚ := (-8810764939390165 / 140737488355328 : ℚ)
def Phat : ℚ := (60696825057999 / 68719476736 : ℚ)

/-! ### Primitive operands of `Omega2` (`Sigma/wpeff.f90`, real, q ≠ 0, nspin = 1) -/

def bdot : Fin 3 → Fin 3 → ℚ := ![![(5065758257150985 / 4503599627370496 : ℚ), (-6754344342867979 / 18014398509481984 : ℚ), (-6754344342867979 / 18014398509481984 : ℚ)],
  ![(-6754344342867979 / 18014398509481984 : ℚ), (5065758257150985 / 4503599627370496 : ℚ), (-6754344342867979 / 18014398509481984 : ℚ)],
  ![(-6754344342867979 / 18014398509481984 : ℚ), (-6754344342867979 / 18014398509481984 : ℚ), (5065758257150985 / 4503599627370496 : ℚ)]]
def qv : Fin 3 → ℚ := ![(0 / 1 : ℚ), (0 / 1 : ℚ), (1 / 2 : ℚ)]
def gv : Fin 3 → ℚ := ![(0 / 1 : ℚ), (0 / 1 : ℚ), (0 / 1 : ℚ)]
def gpv : Fin 3 → ℚ := ![(0 / 1 : ℚ), (0 / 1 : ℚ), (-1 / 1 : ℚ)]
def vcoulG : ℚ := (3177688576971577 / 72057594037927936 : ℚ)
def rhoGG : ℚ := (7676195647328407 / 4503599627370496 : ℚ)
def wpsq : ℚ := (1212066641280879 / 4398046511104 : ℚ)
def nelec : ℚ := (8 / 1 : ℚ)
def coulfact : ℚ := (1676197387459117 / 144115188075855872 : ℚ)

def fact : ℚ := wpsq / nelec
def qg (k : Fin 3) : ℚ := gv k + qv k
def qgp (k : Fin 3) : ℚ := gpv k + qv k
def pre (k : Fin 3) : ℚ := fact * vcoulG * qg k / coulfact

/-- The exact `Omega2` reference: `wpeff`'s expression, no production value used. -/
def OStar : ℚ := (∑ a, qgp a * ∑ b, bdot a b * pre b) * rhoGG
/-- The same expression with every operand in absolute value. -/
def OMag : ℚ := (∑ a, |qgp a| * ∑ b, |bdot a b| * |pre b|) * |rhoGG|

/-! ### References and a-priori budgets -/

def u : ℚ := 1 / 2 ^ 53
def gam (n : ℚ) : ℚ := n * u / (1 - n * u)

def sStar : ℚ := phA * phB * kappa * M2.Rstar srcRow srcCol
def IStar : ℚ := 0 - sStar
def PStar : ℚ := OStar / IStar

def BOmega : ℚ := gam 16 * OMag
def BMap : ℚ := |phA * phB| * (gam 4 * |kappa * M2.Xhat srcRow srcCol|)
def BForm : ℚ := gam 3 * |epsHat|
def LT : ℚ := |phA * phB * kappa|
def BI : ℚ := BMap + BForm + LT * M2.bTotal
def BDiv : ℚ := u * |Ohat / Ihat|
def dd : ℚ := |IStar| - BI
def BP : ℚ := BDiv + BOmega / dd + |OStar| * BI / (|IStar| * dd)

/-- `TOL_Small = 1.0d-6` (`Common/nrtype.f90`), the binary64 value, decoded. -/
def tolSmall : ℚ := (4722366482869645 / 4722366482869645213696 : ℚ)

/-! ### Checked statements -/

/-- The restated literal is M2's own entry. -/
theorem xhat_entry : M2.Xhat srcRow srcCol = xhatLit := by
  norm_num [M2.Xhat, srcRow, srcCol, xhatLit, Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons, Matrix.cons_val_one, Matrix.cons_val_two, Fin.sum_univ_succ]

theorem rstar_entry : M2.Rstar srcRow srcCol = (7557279725365050124731697060751405105826674653839940508810944034793984814193126624548967810926717599182077762354478987718545373594843725307209486726306632207418609770877517469788473738647536666335476892102755735856029480716238190031119219206462020749212254208 / 100049803524304312925504401844570549244689165063586393188611931365443399432762148099695307216368133843801324654079868293155362582452221190537770925869937214923304149316488695534624306888184848284354809988943177021830168108010198586479401791799654151839767610259 : ℚ) := by
  norm_num [M2.Rstar, srcRow, srcCol, Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons, Matrix.cons_val_one, Matrix.cons_val_two, Fin.sum_univ_succ]

/-- The wing normalization, evaluated in binary64, stays within its budget. -/
theorem map_bound : |epsHat - kappa * M2.Xhat srcRow srcCol| ≤ gam 4 * |kappa * M2.Xhat srcRow srcCol| := by
  rw [xhat_entry]
  norm_num [epsHat, kappa, wFact, wOneOverQ, wVcoul1, wQlen, xhatLit, gam, u, abs_le, abs_eq_max_neg]

/-- `I_epsggp = 0 - ph*ph*eps`, formed locally from the consumed operand. -/
theorem formation_bound : |Ihat - (0 - phA * phB * epsHat)| ≤ BForm := by
  norm_num [Ihat, phA, phB, epsHat, BForm, gam, u, abs_le, abs_eq_max_neg]

/-- **Screening denominator.** Production `I_epsggp` against the mapped M2
exact reference, with M2's inherited error carried through. -/
theorem ieps_bound : |Ihat - IStar| ≤ BI := by
  have h1 := formation_bound
  have h2 := map_bound
  have h3 := m2_entry_bound srcRow srcCol
  have e : Ihat - IStar
      = (Ihat - (0 - phA * phB * epsHat))
        + -(phA * phB * (epsHat - kappa * M2.Xhat srcRow srcCol))
        + -(phA * phB * kappa * (M2.Xhat srcRow srcCol - M2.Rstar srcRow srcCol)) := by
    simp only [IStar, sStar]; ring
  rw [e]
  calc _ ≤ |Ihat - (0 - phA * phB * epsHat)|
          + |phA * phB * (epsHat - kappa * M2.Xhat srcRow srcCol)|
          + |phA * phB * kappa * (M2.Xhat srcRow srcCol - M2.Rstar srcRow srcCol)| := by
        refine (abs_add _ _).trans ?_
        rw [abs_neg]
        gcongr
        refine (abs_add _ _).trans ?_
        rw [abs_neg]
    _ = |Ihat - (0 - phA * phB * epsHat)|
          + |phA * phB| * |epsHat - kappa * M2.Xhat srcRow srcCol|
          + LT * |M2.Xhat srcRow srcCol - M2.Rstar srcRow srcCol| := by
        rw [abs_mul (phA * phB), abs_mul (phA * phB * kappa)]; rfl
    _ ≤ BForm + |phA * phB| * (gam 4 * |kappa * M2.Xhat srcRow srcCol|) + LT * M2.bTotal := by
        have hLT : 0 ≤ LT := abs_nonneg _
        exact add_le_add (add_le_add h1 (mul_le_mul_of_nonneg_left h2 (abs_nonneg _)))
          (mul_le_mul_of_nonneg_left h3 hLT)
    _ = BI := by simp only [BI, BMap]; ring

/-- **Numerator.** Production `Omega2` against the independent reference. -/
theorem omega_bound : |Ohat - OStar| ≤ BOmega := by
  norm_num [Ohat, OStar, BOmega, OMag, gam, u, qg, qgp, pre, fact, bdot, qv, gv, gpv,
    vcoulG, rhoGG, wpsq, nelec, coulfact, abs_le, abs_eq_max_neg, Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons, Matrix.cons_val_one, Matrix.cons_val_two, Fin.sum_univ_succ]

/-- **Local quotient.** One binary64 division. -/
theorem div_bound : |Phat - Ohat / Ihat| ≤ BDiv := by
  norm_num [Phat, Ohat, Ihat, BDiv, u, abs_le, abs_eq_max_neg]

/-- The fixed acceptance rule `B_I ≤ |IStar|/2`. -/
theorem budget_half : BI ≤ |IStar| / 2 := by
  rw [IStar, sStar, rstar_entry]
  norm_num [BI, BMap, BForm, LT, phA, phB, kappa, wFact, wOneOverQ, wVcoul1, wQlen,
    epsHat, xhat_entry, xhatLit, gam, u, M2.bTotal, M2.bInv, M2.bShift, M2.nrmEhat,
    M2.nrmRhat, M2.nrmRstar, M2.bForm, abs_le, abs_eq_max_neg]

theorem IStar_ne : IStar ≠ 0 := by
  rw [IStar, sStar, rstar_entry]
  norm_num [phA, phB, kappa, wFact, wOneOverQ, wVcoul1, wQlen]

/-- The squared-pole reference is positive: the ordinary real branch. -/
theorem PStar_pos : 0 < PStar := by
  rw [PStar, IStar, sStar, rstar_entry]
  norm_num [OStar, qg, qgp, pre, fact, bdot, qv, gv, gpv, vcoulG, rhoGG, wpsq, nelec,
    coulfact, phA, phB, kappa, wFact, wOneOverQ, wVcoul1, wQlen, Matrix.cons_val_succ, Matrix.cons_val_zero, Matrix.head_cons, Matrix.cons_val_one, Matrix.cons_val_two, Fin.sum_univ_succ]

/-- **Endpoint.** Production `wtilde2` against the exact squared pole built
from the M2 reference and the primitive operands; composed, not re-measured. -/
theorem wtilde2_bound : |Phat - PStar| ≤ BP :=
  quotient_transfer omega_bound ieps_bound div_bound budget_half IStar_ne

/-- The production mode passes each `cycle` of the real GPP setup and takes
`sqrt`: `|I_epsggp|`, `|Omega2|`, `|wtilde2| ≥ TOL_Small` and `wtilde2 > 0`,
evaluated exactly on the decoded values. That Sigma's comparisons are these
predicates is a source reading, not a Lean fact. -/
theorem survives : tolSmall ≤ |Ihat| ∧ tolSmall ≤ |Ohat| ∧ tolSmall ≤ |Phat| ∧ 0 < Phat := by
  norm_num [tolSmall, Ihat, Ohat, Phat, abs_le, le_abs, abs_eq_max_neg]

end GW.BGW.M4
