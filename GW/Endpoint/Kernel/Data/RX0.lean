/-- **Root bracket `X0` of the full GPP QP equation of `X` (spec A, TRUE eps⁻¹).** For
every value of the Coulomb averages in their certified boxes and either convention at
`wx = wtilde`: `f` is continuous on `[Ea, Eb]` with derivative `f'` in the stated enclosure (< 0),
has exactly one zero in `[Ea, Eb]`, and it lies in `[Ec, Ed]` (an isolating bracket); no point
of `[Ea, Eb]` is one where the source divides by zero. -/
theorem rootX0 (vb oq : V3 → ℝ) (hvb : VbHyp vbT eg.SV vb) (hoq : VbHyp oqT eg.SV oq) :
    SrcDefOn gl Etrue vb oq stX ((CaX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ((CbX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ∧
    (∀ E ∈ Icc ((CaX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ((CbX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)),
      cXv * DX00v - 1 ≤ dfQP gl Etrue vb oq stX E ∧ dfQP gl Etrue vb oq stX E ≤ cXv * DX01v - 1) ∧
    ∀ cv : Bool,
      IsolatingBracket (fQP gl Etrue vb oq stX cv) (dfQP gl Etrue vb oq stX)
        ((CcX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ((CdX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ∧
      (∃! E, E ∈ Icc ((CaX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ((CbX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ∧ fQP gl Etrue vb oq stX cv E = 0) ∧
      ∀ E ∈ Icc ((CaX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ((CbX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)), fQP gl Etrue vb oq stX cv E = 0 →
        E ∈ Icc ((CcX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) ((CdX0 : ℝ) / (10 ^ 8 * 2 ^ 92 : ℝ)) := by
  have hc := cX_eq
  have H := root_bracket dX rqX0 okX hEX hvb (oq_scaled hoq) hX (by decide) (by decide) rokX0
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by rw [hc, DX01]; norm_num [cXv, DX01v])
    (by rw [hc, LX000, emfX0, den_eqX0]; norm_num [cXv, LX000v, eoXv, CcX0])
    (by rw [hc, LX011, emfX0, den_eqX0]; norm_num [cXv, LX011v, eoXv, CdX0])
  simp only [] at H
  rw [hc, DX00, DX01, den_eqX0] at H
  exact H

