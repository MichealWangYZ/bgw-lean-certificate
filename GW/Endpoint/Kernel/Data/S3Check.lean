theorem LL11 : LtotZ dL gl.qs.length stL.ck.length (nbq stL) 1 1 = LL11v := by decide +kernel
noncomputable def cLv : ℝ := 1360569253 / 1388940293980793791850766408378359516999113137724950542809038848000000000
noncomputable def eoLv : ℝ := 539977216069268514373947 / 45035996273704960000000
theorem cL_eq : RYD / (stL.ck.length * (Nq gl * vol gl) * 4 * 2 ^ 200) = cLv := by
  have hl : stL.ck.length = 1 := by decide +kernel
  have hq : gl.qs.length = 8 := by decide +kernel
  rw [hl]; unfold RYD Nq vol dy cLv; rw [hq]; norm_num [gl]
theorem eoL_eq : avg stL (fun a => RYD * dy gl.SEn (stL.Ek.getD a 0)) = eoLv := by
  have hl : stL.ck.length = 1 := by decide +kernel
  have h0 : stL.Ek.getD 0 0 = 254000608585215360 := by decide +kernel
  unfold avg; rw [hl]; simp only [Finset.sum_range_succ, Finset.sum_range_zero, h0]; unfold RYD dy eoLv; norm_num [gl]

/-- The Coulomb hypothesis on `oneoverq`, scaled. -/
theorem oq_scaled {oq : V3 → ℝ} (h : VbHyp oqT eg.SV oq) :
    ∀ p ∈ oqT, (p.2.1 : ℝ) ≤ oq p.1 * 2 ^ eg.SV ∧ oq p.1 * 2 ^ eg.SV ≤ p.2.2 := h.scaled

theorem hX : 0 < Nq gl * vol gl := by
  unfold Nq vol dy; norm_num [gl, qs]

/-- **Eqp1 of `X`** in the kernel-derived enclosure. -/
theorem eqpX (vb oq : V3 → ℝ) (hvb : VbHyp vbT eg.SV vb) (hoq : VbHyp oqT eg.SV oq) :
    let c := RYD / (stX.ck.length * (Nq gl * vol gl) * 4 * 2 ^ 200)
    let eo := avg stX (fun a => RYD * dy gl.SEn (stX.Ek.getD a 0))
    eo + c * (LX00v : ℝ) / (1 - (c * LX11v - c * LX00v)) ≤ eqp1 gl Etrue vb oq stX ∧
      eqp1 gl Etrue vb oq stX ≤ eo + c * (LX01v : ℝ) / (1 - (c * LX10v - c * LX01v)) := by
  have s0 := sig_bounds dX okX hEX hvb (oq_scaled hoq) hX 0 (by norm_num)
  have s1 := sig_bounds dX okX hEX hvb (oq_scaled hoq) hX 1 (by norm_num)
  rw [Ltot_cast, Ltot_cast, LX00, LX01] at s0
  rw [Ltot_cast, Ltot_cast, LX10, LX11] at s1
  exact eqp1_bounds gl Etrue vb oq stX 200 (by decide) hX s0 s1
    (by rw [cX_eq]; norm_num [LX01v, cXv]) (by rw [cX_eq]; norm_num [LX11v, LX00v, cXv])

/-- **Eqp1 of `L`** in the kernel-derived enclosure. -/
theorem eqpL (vb oq : V3 → ℝ) (hvb : VbHyp vbT eg.SV vb) (hoq : VbHyp oqT eg.SV oq) :
    let c := RYD / (stL.ck.length * (Nq gl * vol gl) * 4 * 2 ^ 200)
    let eo := avg stL (fun a => RYD * dy gl.SEn (stL.Ek.getD a 0))
    eo + c * (LL00v : ℝ) / (1 - (c * LL11v - c * LL00v)) ≤ eqp1 gl Etrue vb oq stL ∧
      eqp1 gl Etrue vb oq stL ≤ eo + c * (LL01v : ℝ) / (1 - (c * LL10v - c * LL01v)) := by
  have s0 := sig_bounds dL okL hEL hvb (oq_scaled hoq) hX 0 (by norm_num)
  have s1 := sig_bounds dL okL hEL hvb (oq_scaled hoq) hX 1 (by norm_num)
  rw [Ltot_cast, Ltot_cast, LL00, LL01] at s0
  rw [Ltot_cast, Ltot_cast, LL10, LL11] at s1
  exact eqp1_bounds gl Etrue vb oq stL 200 (by decide) hX s0 s1
    (by rw [cL_eq]; norm_num [LL01v, cLv]) (by rw [cL_eq]; norm_num [LL11v, LL00v, cLv])

/-- **O1 enclosure (spec A, kernel-checked).** For every value of the mini-BZ Coulomb
averages `vb` and `oneoverq` inside their certified boxes (`coulomb_cert.json`), the
observable `O1 = Eqp1(X, bands 5-6 avg) - Eqp1(L, band 5)` of spec A, evaluated on the TRUE
eps⁻¹ (stage 2, from the wavefunction coefficients), lies in cert.py's enclosure
`[0.015405752349084699, 0.015405753672648183]` eV (the binary64 bounds of `cert_o1.json`). -/
theorem o1_enclosure (vb oq : V3 → ℝ) (hvb : VbHyp vbT eg.SV vb) (hoq : VbHyp oqT eg.SV oq) :
    O1 gl stX stL Etrue vb oq ∈ Set.Icc ((8880811588953599 : ℝ) / 2 ^ 59) ((8880812351936001 : ℝ) / 2 ^ 59) := by
  have hx := eqpX vb oq hvb hoq
  have hl := eqpL vb oq hvb hoq
  simp only [] at hx hl
  rw [cX_eq, eoX_eq] at hx
  rw [cL_eq, eoL_eq] at hl
  obtain ⟨x1, x2⟩ := hx
  obtain ⟨l1, l2⟩ := hl
  unfold O1
  constructor
  · have : ((8880811588953599 : ℝ) / 2 ^ 59) ≤ eoXv + cXv * (LX00v : ℝ) / (1 - (cXv * LX11v - cXv * LX00v)) -
        (eoLv + cLv * (LL01v : ℝ) / (1 - (cLv * LL10v - cLv * LL01v))) := by
      norm_num [eoXv, eoLv, cXv, cLv, LX00v, LX11v, LL01v, LL10v]
    linarith
  · have : eoXv + cXv * (LX01v : ℝ) / (1 - (cXv * LX10v - cXv * LX01v)) -
        (eoLv + cLv * (LL00v : ℝ) / (1 - (cLv * LL11v - cLv * LL00v))) ≤ ((8880812351936001 : ℝ) / 2 ^ 59) := by
      norm_num [eoXv, eoLv, cXv, cLv, LX01v, LX10v, LL00v, LL11v]
    linarith

/-- **C1 for spec A**: `Eqp1(X) > Eqp1(L)`. The theorem compares X and L only; that the
minimum over ALL sampled k-points (Γ included) is at L is the Python `CBM_certainly_at_L`
of `cert_o1.json`, not a Lean statement. -/
theorem o1_pos (vb oq : V3 → ℝ) (hvb : VbHyp vbT eg.SV vb) (hoq : VbHyp oqT eg.SV oq) :
    0 < O1 gl stX stL Etrue vb oq :=
  lt_of_lt_of_le (by norm_num) (o1_enclosure vb oq hvb hoq).1

end GW.Endpoint.Kernel.S3
