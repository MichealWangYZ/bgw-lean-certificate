number_bands 18

band_index_min 1
band_index_max 8

screening_semiconductor

begin kpoints
  0.000000000  0.000000000  0.000000000   1.0
  0.000000000  0.000000000  0.500000000   1.0
  0.000000000  0.500000000  0.500000000   1.0
end

dont_use_vxcdat
exact_static_ch 1

number_offdiag 3
begin offdiag
  1 1 1
  1 8 1
  2 1 2
end
no_symmetries_q_grid

# T-003 probe: place the Fermi level exactly on inner band 1 so that
# abs(e_n1kq - efermi) < sig%tol holds and mtxel_cor.f90:1399-1403 gives occ=0.5
fermi_level_absolute
fermi_level -2.55213402880262530
